# Quale agriturismo compilare. Corrisponde a una cartella dentro tenants/.
# Copia questo file in .env e cambia il valore, oppure passa la variabile
# direttamente al comando:  SITE_ID=podere-rosa npm run build:static
SITE_ID=nerbona

# Sottocartella in cui viene pubblicato il sito. Lascia vuoto se sta nella
# radice del dominio.
#   https://esempio.it        -> BASE_PATH=
#   https://esempio.it/demo   -> BASE_PATH=/demo
BASE_PATH=
